{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/frontend.tsbuildinfo"
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.vue",
    "./env.d.ts",
    "./vite-env.d.ts",
    "../shared/**/*.ts",
    "../../types/*.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    // Node-only seeding code that reaches into src/backend; never bundled
    // into the renderer.
    "../shared/database/demo/**",
    "../shared/database/seeds/**"
  ]
}
