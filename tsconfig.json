{
  // Aggregate config for editors/tooling that expect a root tsconfig.
  // `npm run type-check` checks each project separately, because the node,
  // renderer, and test code need different `lib`/`types` settings:
  //   tsconfig.node.json        - main, backend, cli, shared (no DOM)
  //   src/frontend/tsconfig.json - renderer + .vue files (DOM, checked by vue-tsc)
  //   tsconfig.test.json        - test suites
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "types/**/*.d.ts"]
}
